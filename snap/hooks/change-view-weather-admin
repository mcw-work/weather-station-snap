#!/bin/bash
# change-view-weather-admin: validate an incoming confdb weather write.
#
# Runs on every confdb transaction, including partial writes made while the
# admin sets values one key at a time. Only fields that are *present* are
# validated; absent fields are allowed (the daemon refuses to start until the
# configuration is complete). Numeric range checks are enforced by the storage
# schema, so the only cross-field rule checked here is that the mqtt.server
# scheme is consistent with the tcp port.
#
# api-key has visibility:secret, so snapd redacts it from the values this hook
# reads back; its presence is enforced by the daemon's own startup validation.
set -u

log() { logger -t "weatherstation.change-view" "$1" 2>/dev/null || true; }

get_conf() { snapctl get ":weather-admin" "$1" 2>/dev/null || true; }

log "validating confdb weather write"

server=$(get_conf "weather.mqtt.server")

# No server set yet: partial write is fine.
if [[ -z "$server" ]]; then
    exit 0
fi

case "$server" in
    unix://*)
        exit 0
        ;;
    tcp://*)
        port=$(get_conf "weather.mqtt.port")
        # Port not set yet: partial write is fine.
        if [[ -z "$port" ]]; then
            exit 0
        fi
        # Must be a decimal integer.
        if [[ ! "$port" =~ ^[0-9]+$ ]]; then
            log "rejecting confdb write: mqtt.port must be an integer, got $port"
            exit 1
        fi
        if (( port < 1 || port > 65535 )); then
            log "rejecting confdb write: mqtt.port must be 1..65535 for tcp, got $port"
            exit 1
        fi
        exit 0
        ;;
    *)
        log "rejecting confdb write: mqtt.server must use a tcp:// or unix:// scheme"
        exit 1
        ;;
esac
