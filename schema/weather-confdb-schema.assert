type: confdb-schema
authority-id: bpyPt7Qr2Qbui3MJMgyzZ3WaQkyj6OkU
revision: 3
account-id: bpyPt7Qr2Qbui3MJMgyzZ3WaQkyj6OkU
name: weather
summary: OpenWeather data published to MQTT, configured via confdb.
timestamp: 2026-06-25T08:31:59Z
views:
  admin:
    rules:
      -
        access: read-write
        request: weather.{key}
        storage: v1.weather.{key}
      -
        access: read-write
        request: weather.location.{key}
        storage: v1.weather.location.{key}
      -
        access: read-write
        request: weather.mqtt.{key}
        storage: v1.weather.mqtt.{key}
    summary: Read-write control view used by the custodian snap.
  state:
    rules:
      -
        access: read
        request: weather.{key}
        storage: v1.weather.{key}
      -
        access: read
        request: weather.location.{key}
        storage: v1.weather.location.{key}
      -
        access: read
        request: weather.mqtt.{key}
        storage: v1.weather.mqtt.{key}
    summary: Read-only view for observer snaps.
body-length: 1300
sign-key-sha3-384: cOvVeiH3apl1_GK6izPVrcvtTu4QcVEjOtqysUuFLV2cNbtc4rT6K_Ii3Fe2NwBH

{
  "storage": {
    "schema": {
      "v1": {
        "schema": {
          "weather": {
            "schema": {
              "api-key": {
                "type": "string",
                "visibility": "secret"
              },
              "location": {
                "schema": {
                  "lat": {
                    "max": 90,
                    "min": -90,
                    "type": "number"
                  },
                  "lon": {
                    "max": 180,
                    "min": -180,
                    "type": "number"
                  }
                },
                "type": "map"
              },
              "mqtt": {
                "schema": {
                  "port": {
                    "max": 65535,
                    "min": 1,
                    "type": "int"
                  },
                  "server": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  }
                },
                "type": "map"
              },
              "poll-interval": {
                "min": 60,
                "type": "int"
              }
            },
            "type": "map"
          }
        },
        "type": "map"
      }
    }
  }
}

